<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- === ASP.NET Core Hosting (Your App) === -->
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\SahayataNidhi.exe"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess"
                  forwardWindowsAuthToken="true" />

      <!-- === REVERSE PROXY RULE: Forward /handshake to Console App === -->
      <rewrite>
        <rules>
          <rule name="JanParichayHandshakeProxy" stopProcessing="true">
            <match url="^handshake(.*)" />
            <action type="Rewrite" url="http://localhost:8081/handshake{R:1}" />
          </rule>
        </rules>
      </rewrite>

      <!-- === INCREASE TIMEOUTS & LIMITS (Critical for slow console app) === -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="104857600" /> <!-- 100 MB -->
        </requestFiltering>
      </security>

      <!-- === EXECUTION TIMEOUT (5 minutes) === -->
      <serverRuntime executionTimeout="300" />

      <!-- === OPTIONAL: Better logging === -->
      <httpLogging dontLog="false" />
    </system.webServer>
  </location>

  <!-- ============================================== -->
  <!-- GLOBAL ARR PROXY SETTINGS (MACHINE LEVEL)      -->
  <!-- Run these ONCE in Admin CMD (elevated)         -->
  <!-- ============================================== -->
  <!--
    1. %windir%\system32\inetsrv\appcmd set config -section:system.webServer/proxy /enabled:"True" /commit:apphost
    2. %windir%\system32\inetsrv\appcmd set config -section:system.webServer/proxy /preserveHostHeader:"True" /commit:apphost
    3. %windir%\system32\inetsrv\appcmd set config -section:system.webServer/proxy /bufferResponse:"True" /commit:apphost
    4. %windir%\system32\inetsrv\appcmd set config -section:system.webServer/proxy /timeout:"00:05:00" /commit:apphost
  -->
</configuration>