<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- === Your existing ASP.NET Core hosting === -->
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\SahayataNidhi.exe" 
                  stdoutLogEnabled="true" 
                  stdoutLogFile=".\logs\stdout" 
                  hostingModel="inprocess" 
                  forwardWindowsAuthToken="true" />

      <!-- === REVERSE PROXY TO JAN PARICHAY CONSOLE APP === -->
      <rewrite>
        <rules>
          <rule name="JanParichayHandshakeProxy" stopProcessing="true">
            <match url="^handshake(.*)" />
            <action type="Rewrite" url="http://localhost:8081/handshake{R:1}" />
            <serverVariables>
              <set name="HTTP_X_ORIGINAL_ACCEPT_ENCODING" value="{HTTP_ACCEPT_ENCODING}" />
              <set name="HTTP_ACCEPT_ENCODING" value="" />
            </serverVariables>
          </rule>
        </rules>
      </rewrite>

      <!-- === APPLICATION REQUEST ROUTING (ARR) PROXY SETTINGS === -->
      <proxy 
        enabled="true" 
        preserveHostHeader="true"
        reverseRewriteHostInResponseHeaders="false"
        bufferResponse="true" 
        timeout="00:05:00"
        keepAlive="true"
        maxConnections="10000" />

      <!-- === INCREASE LIMITS FOR LARGE ENCRYPTED PAYLOADS === -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="104857600" /> <!-- 100 MB -->
          <headerLimits>
            <add header="Content-Length" sizeLimit="104857600" />
          </headerLimits>
        </requestFiltering>
      </security>

      <!-- === OPTIONAL: BETTER LOGGING FOR DEBUGGING === -->
      <httpLogging dontLog="false" />
    </system.webServer>
  </location>

  <!-- === ENABLE ARR PROXY AT MACHINE LEVEL (IF NOT ALREADY) === -->
  <!-- Run once in elevated cmd: %windir%\system32\inetsrv\appcmd set config -section:system.webServer/proxy /enabled:"True" /commit:apphost -->
</configuration>