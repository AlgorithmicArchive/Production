<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- ASP.NET Core handler -->
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <!-- ASP.NET Core Module – OUT-OF-PROCESS (most reliable on IIS) -->
      <aspNetCore 
          processPath="dotnet"
          arguments=".\SahayataNidhi.dll"
          stdoutLogEnabled="true"
          stdoutLogFile=".\logs\stdout"
          hostingModel="outofprocess"
          startupTimeLimit="120"
          processesPerApplication="1">

        <!-- DEVELOPMENT ENVIRONMENT + DETAILED ERRORS -->
        <environmentVariables>
          <!-- Tell the app it is Development -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Development" />

          <!-- Show full exception stack traces in the browser -->
          <environmentVariable name="ASPNETCORE_DETAILEDERRORS" value="1" />

          <!-- Force Developer Exception Page (overrides UseExceptionHandler) -->
          <environmentVariable name="ASPNETCORE_USE_DEVELOPER_EXCEPTION_PAGE" value="1" />
        </environmentVariables>

      </aspNetCore>

      <!-- Force IIS to return detailed errors instead of generic 500/503 -->
      <httpErrors errorMode="Detailed" />

      <!-- Optional: custom error pages (uncomment if you have them) -->
      <!--
      <httpErrors>
        <remove statusCode="500" />
        <error statusCode="500" path="/Home/Error" responseMode="ExecuteURL" />
        <remove statusCode="503" />
        <error statusCode="503" path="/Home/Error503" responseMode="ExecuteURL" />
      </httpErrors>
      -->

    </system.webServer>
  </location>
</configuration>